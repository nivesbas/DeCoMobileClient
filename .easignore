# EAS Build excludes files the same way .gitignore does, UNLESS an .easignore
# exists — then this file wins. We need google-services.json to be uploaded
# to the cloud builder (Firebase config is per-tenant and bound to a specific
# Android package name; the build can't produce a working FCM-enabled APK
# without it). .gitignore keeps it out of the repo; this keeps it IN the
# upload archive. Same pattern for the iOS plist.
#
# Everything else from .gitignore is repeated here so EAS doesn't upload
# 1.5 GB of node_modules or native build artifacts.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (signing material — NEVER upload)
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# NOTE: google-services.json / GoogleService-Info.plist are DELIBERATELY
# absent from this file so EAS uploads them. They must exist at repo root
# before `eas build` is run. See README.md "Firebase bootstrap".

# Local build artifacts & dev noise (no reason to ship to EAS builder)
.claude/
*.apk
*-build.log
*-rebuild.log
logcat-*.log
eas-local-build.log
